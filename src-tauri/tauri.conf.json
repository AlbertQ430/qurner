{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qurner",
  "version": "0.1.0",
  "identifier": "com.qurner.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qurner",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: cover:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src epub:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "shortDescription": "Qurner 个人电子书阅读器",
    "longDescription": "离线可用、尊重原作排版的个人电子书阅读器。",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
