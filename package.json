{
  "name": "qurner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Qurner 个人电子书阅读器",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "tsc -b && biome check . && vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/test": "^1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "jsdom": "^26",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  }
}
